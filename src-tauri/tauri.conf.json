{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ramure",
  "version": "0.2.0",
  "identifier": "dev.ramure.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ramure",
        "width": 1440,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kihak12/Ramure/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCOEUwOTQyMzBGREI3RjgKUldUNHQvMHdRZ21PcTdiRHYrWEZrTmtKQll3WjhycDNZdStsNlZ2Rm1CdlVBNWFlQmYzUlhGNUoK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Ramure contributors",
    "homepage": "https://github.com/kihak12/Ramure",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Graphical Git client and SSH client",
    "longDescription": "A graphical Git client and an SSH client in one window: commit graph, staging by line, interactive rebase, a host book, terminals and tunnels. Local, no account.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "section": "devel"
      }
    }
  }
}
